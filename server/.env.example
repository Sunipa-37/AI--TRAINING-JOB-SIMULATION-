# Copy this file to .env and fill in your own values

PORT=4000

# Either set DATABASE_URL...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trainly

# ...or set these individually (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=trainly

# Secret used to sign login sessions (JWTs). Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Anyone who signs up with this code in the "Facilitator code" field becomes an admin.
# Keep this private and only share it with facilitators/teachers.
ADMIN_SIGNUP_CODE=changeme-admin-code

# Optional: seeds one ready-to-use admin account when you run `npm run db:setup`.
SEED_ADMIN_EMAIL=admin@trainly.app
SEED_ADMIN_PASSWORD=Trainly@Admin1

# Optional: enables real "Continue with Google" login.
# Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# and put the same value in client/.env as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173
