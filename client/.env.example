VITE_API_URL=http://localhost:4000/api

# Optional: enables the real "Continue with Google" button.
# Create an OAuth Client ID at https://console.cloud.google.com/apis/credentials
# (Authorized JavaScript origin: your dev URL, e.g. http://localhost:5173)
# and put the SAME value in server/.env as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
